rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------
    // Validation Helpers
    // -----------------------------------------------------------
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.patientName is string && data.patientName.size() <= 100 &&
             data.patientAge is string && data.patientAge.size() <= 20 &&
             data.currentWeek is int && data.currentWeek >= 1 && data.currentWeek <= 45 &&
             data.dueDate is string && data.dueDate.size() <= 100 &&
             data.daysRemaining is int && data.daysRemaining >= 0 && data.daysRemaining <= 400 &&
             data.dashboardDueDateText is string && data.dashboardDueDateText.size() <= 100 &&
             data.gestationalWeeks is int && data.gestationalWeeks >= 1 && data.gestationalWeeks <= 45 &&
             data.gestationalDaysRemainder is int && data.gestationalDaysRemainder >= 0 && data.gestationalDaysRemainder <= 6 &&
             data.remainingCountdownDays is int && data.remainingCountdownDays >= 0 && data.remainingCountdownDays <= 400 &&
             data.currentTrimester is string && data.currentTrimester.size() <= 60 &&
             data.progressPercent is number && data.progressPercent >= 0.0 && data.progressPercent <= 1.0 &&
             data.healthMood is string && data.healthMood.size() <= 100 &&
             data.healthWeight is string && data.healthWeight.size() <= 30 &&
             data.waterGlasses is int && data.waterGlasses >= 0 && data.waterGlasses <= 50 &&
             data.bloodPressure is string && data.bloodPressure.size() <= 30 &&
             data.personalNotesText is string && data.personalNotesText.size() <= 5000 &&
             data.momAvatar is string && data.momAvatar.size() <= 20 &&
             data.partnerAvatar is string && data.partnerAvatar.size() <= 20 &&
             data.babyAvatar is string && data.babyAvatar.size() <= 20 &&
             data.languageCode in ['FR', 'EN'] &&
             data.themePaletteName is string && data.themePaletteName.size() <= 50 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTask(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.date is string && data.date.size() <= 100 &&
             data.category is string && data.category.size() <= 100 &&
             data.details is string && data.details.size() <= 2000 &&
             data.isCompleted is bool &&
             data.hasAlarm is bool &&
             data.alarmTimeMinutesBefore is int && data.alarmTimeMinutesBefore >= 0 && data.alarmTimeMinutesBefore <= 10080 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNote(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 5000 &&
             data.category is string && data.category.size() <= 100 &&
             data.timestampText is string && data.timestampText.size() <= 100 &&
             data.mood is string && data.mood.size() <= 100 &&
             data.symptoms is list && data.symptoms.size() <= 20 &&
             (data.symptoms.size() == 0 || data.symptoms[0] is string) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAppointment(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.dateStr is string && data.dateStr.size() <= 100 &&
             data.timeStr is string && data.timeStr.size() <= 50 &&
             data.doctor is string && data.doctor.size() <= 150 &&
             data.location is string && data.location.size() <= 200 &&
             data.clinicalNotes is string && data.clinicalNotes.size() <= 2000 &&
             data.eventType is string && data.eventType.size() <= 50 &&
             data.dayOfMonth is int && data.dayOfMonth >= 0 && data.dayOfMonth <= 31 &&
             data.monthIndex is int && data.monthIndex >= 0 && data.monthIndex <= 11 &&
             data.yearNum is int && data.yearNum >= 2020 && data.yearNum <= 2035 &&
             data.isCompleted is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidDocument(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.dateStr is string && data.dateStr.size() <= 100 &&
             data.summary is string && data.summary.size() <= 2000 &&
             data.source is string && data.source.size() <= 50 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidChecklistItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.listKey is string && data.listKey.size() >= 1 && data.listKey.size() <= 50 &&
             data.label is string && data.label.size() <= 300 &&
             data.isChecked is bool &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidProtocolStep(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.phaseId is int && data.phaseId >= 1 && data.phaseId <= 4 &&
             data.dateStr is string && data.dateStr.size() <= 100 &&
             data.stepName is string && data.stepName.size() <= 200 &&
             data.medication is string && data.medication.size() <= 150 &&
             data.dosage is string && data.dosage.size() <= 100 &&
             data.status is string && data.status.size() <= 50 &&
             data.details is string && data.details.size() <= 2000 &&
             data.isCompleted is bool &&
             data.isCriticalWindow is bool &&
             data.targetEpochMillis is int && data.targetEpochMillis >= 0 &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidCareProvider(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.providerType is string && data.providerType.size() <= 60 &&
             data.name is string && data.name.size() <= 150 &&
             data.affiliation is string && data.affiliation.size() <= 200 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.emergencyContact is string && data.emergencyContact.size() <= 50 &&
             data.address is string && data.address.size() <= 250 &&
             data.portalLink is string && data.portalLink.size() <= 300 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidVoiceMemo(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.durationSec is int && data.durationSec >= 0 && data.durationSec <= 300 &&
             data.timestampText is string && data.timestampText.size() <= 100 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidKickLog(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.count is int && data.count >= 0 && data.count <= 1000 &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWeightLog(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.weightKg is number && data.weightKg >= 20.0 && data.weightKg <= 300.0 &&
             data.week is int && data.week >= 1 && data.week <= 45 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidContraction(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 3600 &&
             data.intervalSeconds is int && data.intervalSeconds >= 0 && data.intervalSeconds <= 86400 &&
             data.intensity is string && data.intensity.size() <= 50 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidWalletCard(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.cardTitle is string && data.cardTitle.size() >= 1 && data.cardTitle.size() <= 120 &&
             data.cardCategory is string && data.cardCategory.size() >= 1 && data.cardCategory.size() <= 60 &&
             data.cardNumber is string && data.cardNumber.size() <= 80 &&
             data.holderName is string && data.holderName.size() <= 100 &&
             data.expiryDate is string && data.expiryDate.size() <= 30 &&
             data.notes is string && data.notes.size() <= 500 &&
             data.gradientKey in ['teal', 'sunset_orange', 'magenta_blue', 'deep_purple'] &&
             data.frontImageBase64 is string && data.frontImageBase64.size() <= 420000 &&
             data.backImageBase64 is string && data.backImageBase64.size() <= 420000 &&
              data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 1000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidMedReminder(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 150 &&
             data.medication is string && data.medication.size() <= 150 &&
             data.dosage is string && data.dosage.size() <= 100 &&
             data.hour is int && data.hour >= 0 && data.hour <= 23 &&
             data.minute is int && data.minute >= 0 && data.minute <= 59 &&
             data.repeatDaily is bool &&
             data.isEnabled is bool &&
             data.protocolPhase is string && data.protocolPhase.size() <= 100 &&
             data.notes is string && data.notes.size() <= 500 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPregnancyMedication(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
             data.activeIngredient is string && data.activeIngredient.size() <= 150 &&
             data.category is string && data.category.size() <= 100 &&
             data.safetyLevel in ['SAFE', 'CAUTION', 'AVOID'] &&
             data.trimester1 is string && data.trimester1.size() <= 100 &&
             data.trimester2 is string && data.trimester2.size() <= 100 &&
             data.trimester3 is string && data.trimester3.size() <= 100 &&
             data.clinicalNotes is string && data.clinicalNotes.size() <= 2000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNutritionFood(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
             data.category is string && data.category.size() <= 100 &&
             data.safetyStatus in ['EAT', 'LIMIT', 'AVOID'] &&
             data.highlights is string && data.highlights.size() <= 1000 &&
             data.nutrients is string && data.nutrients.size() <= 300 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidGroceryItem(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.quantity is string && data.quantity.size() <= 80 &&
             data.isChecked is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidHealthIssue(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.trimester is string && data.trimester.size() <= 50 &&
             data.severity is string && data.severity.size() <= 50 &&
             data.dateStr is string && data.dateStr.size() <= 80 &&
             data.symptoms is string && data.symptoms.size() <= 1500 &&
             data.doctorNotes is string && data.doctorNotes.size() <= 2000 &&
             data.prescribedTreatment is string && data.prescribedTreatment.size() <= 1000 &&
             data.isResolved is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidExpenseRecord(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 200 &&
             data.amount is number && data.amount >= 0.0 && data.amount <= 1000000000.0 &&
             data.currency in ['USD', 'EUR', 'XOF'] &&
             data.category is string && data.category.size() <= 100 &&
             data.phase is string && data.phase.size() <= 60 &&
             data.dateStr is string && data.dateStr.size() <= 80 &&
             data.notes is string && data.notes.size() <= 1000 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    // -----------------------------------------------------------
    // User-Scoped Collections
    // -----------------------------------------------------------
    match /users/{userId}/profile/{profileId} {
      allow get: if isOwner(userId) && isValidId(profileId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(profileId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll([
                         'userId', 'patientName', 'patientAge', 'currentWeek', 'dueDate', 'daysRemaining',
                         'dashboardDueDateText', 'gestationalWeeks', 'gestationalDaysRemainder',
                         'remainingCountdownDays', 'currentTrimester', 'progressPercent',
                         'healthMood', 'healthWeight', 'waterGlasses', 'bloodPressure',
                         'personalNotesText', 'momAvatar', 'partnerAvatar', 'babyAvatar',
                         'languageCode', 'themePaletteName', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'patientName', 'patientAge', 'currentWeek', 'dueDate', 'daysRemaining',
                         'dashboardDueDateText', 'gestationalWeeks', 'gestationalDaysRemainder',
                         'remainingCountdownDays', 'currentTrimester', 'progressPercent',
                         'healthMood', 'healthWeight', 'waterGlasses', 'bloodPressure',
                         'personalNotesText', 'momAvatar', 'partnerAvatar', 'babyAvatar',
                         'languageCode', 'themePaletteName', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidUserProfile(incoming()) &&
                       isOwner(userId) && isValidId(profileId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['patientName', 'patientAge', 'currentWeek', 'dueDate', 'daysRemaining', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['dashboardDueDateText', 'gestationalWeeks', 'gestationalDaysRemainder', 'remainingCountdownDays', 'currentTrimester', 'progressPercent', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['healthMood', 'healthWeight', 'waterGlasses', 'bloodPressure', 'personalNotesText', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['waterGlasses', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['currentWeek', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['momAvatar', 'partnerAvatar', 'babyAvatar', 'languageCode', 'themePaletteName', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'patientName', 'patientAge', 'currentWeek', 'dueDate', 'daysRemaining',
                           'dashboardDueDateText', 'gestationalWeeks', 'gestationalDaysRemainder',
                           'remainingCountdownDays', 'currentTrimester', 'progressPercent',
                           'healthMood', 'healthWeight', 'waterGlasses', 'bloodPressure',
                           'personalNotesText', 'momAvatar', 'partnerAvatar', 'babyAvatar',
                           'languageCode', 'themePaletteName', 'updatedAt'
                         ])
                       );
      allow delete: if isOwner(userId) && isValidId(profileId);
    }

    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId) && isValidId(taskId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(taskId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'title', 'date', 'category', 'details', 'isCompleted', 'hasAlarm', 'alarmTimeMinutesBefore', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'date', 'category', 'details', 'isCompleted', 'hasAlarm', 'alarmTimeMinutesBefore', 'createdAt', 'updatedAt']) &&
                       isValidTask(incoming());
      allow update: if isSignedIn() && isValidTask(incoming()) &&
                       isOwner(userId) && isValidId(taskId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['isCompleted', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'date', 'category', 'details', 'isCompleted', 'hasAlarm', 'alarmTimeMinutesBefore', 'updatedAt'])
                       );
      allow delete: if isOwner(userId) && isValidId(taskId);
    }

    match /users/{userId}/notes/{noteId} {
      allow get: if isOwner(userId) && isValidId(noteId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(noteId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'title', 'content', 'category', 'timestampText', 'mood', 'symptoms', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'content', 'category', 'timestampText', 'mood', 'symptoms', 'createdAt', 'updatedAt']) &&
                       isValidNote(incoming());
      allow update: if isSignedIn() && isValidNote(incoming()) &&
                       isOwner(userId) && isValidId(noteId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'category', 'timestampText', 'mood', 'symptoms', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(noteId);
    }

    match /users/{userId}/appointments/{appointmentId} {
      allow get: if isOwner(userId) && isValidId(appointmentId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(appointmentId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'title', 'dateStr', 'timeStr', 'doctor', 'location', 'clinicalNotes', 'eventType', 'dayOfMonth', 'monthIndex', 'yearNum', 'isCompleted', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'dateStr', 'timeStr', 'doctor', 'location', 'clinicalNotes', 'eventType', 'dayOfMonth', 'monthIndex', 'yearNum', 'isCompleted', 'createdAt', 'updatedAt']) &&
                       isValidAppointment(incoming());
      allow update: if isSignedIn() && isValidAppointment(incoming()) &&
                       isOwner(userId) && isValidId(appointmentId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['isCompleted', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'dateStr', 'timeStr', 'doctor', 'location', 'clinicalNotes', 'eventType', 'dayOfMonth', 'monthIndex', 'yearNum', 'isCompleted', 'updatedAt'])
                       );
      allow delete: if isOwner(userId) && isValidId(appointmentId);
    }

    match /users/{userId}/documents/{docId} {
      allow get: if isOwner(userId) && isValidId(docId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(docId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'title', 'category', 'dateStr', 'summary', 'source', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'category', 'dateStr', 'summary', 'source', 'createdAt', 'updatedAt']) &&
                       isValidDocument(incoming());
      allow update: if isSignedIn() && isValidDocument(incoming()) &&
                       isOwner(userId) && isValidId(docId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'dateStr', 'summary', 'source', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(docId);
    }

    match /users/{userId}/checklists/{itemId} {
      allow get: if isOwner(userId) && isValidId(itemId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(itemId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'listKey', 'label', 'isChecked', 'sortOrder', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'listKey', 'label', 'isChecked', 'sortOrder', 'createdAt', 'updatedAt']) &&
                       isValidChecklistItem(incoming());
      allow update: if isSignedIn() && isValidChecklistItem(incoming()) &&
                       isOwner(userId) && isValidId(itemId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['isChecked', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['listKey', 'label', 'isChecked', 'sortOrder', 'updatedAt'])
                       );
      allow delete: if isOwner(userId) && isValidId(itemId);
    }

    match /users/{userId}/protocol_steps/{stepId} {
      allow get: if isOwner(userId) && isValidId(stepId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(stepId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'phaseId', 'dateStr', 'stepName', 'medication', 'dosage', 'status', 'details', 'isCompleted', 'isCriticalWindow', 'targetEpochMillis', 'sortOrder', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'phaseId', 'dateStr', 'stepName', 'medication', 'dosage', 'status', 'details', 'isCompleted', 'isCriticalWindow', 'targetEpochMillis', 'sortOrder', 'createdAt', 'updatedAt']) &&
                       isValidProtocolStep(incoming());
      allow update: if isSignedIn() && isValidProtocolStep(incoming()) &&
                       isOwner(userId) && isValidId(stepId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['isCompleted', 'status', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['phaseId', 'dateStr', 'stepName', 'medication', 'dosage', 'status', 'details', 'isCompleted', 'isCriticalWindow', 'targetEpochMillis', 'sortOrder', 'updatedAt'])
                       );
      allow delete: if isOwner(userId) && isValidId(stepId);
    }

    match /users/{userId}/care_providers/{providerId} {
      allow get: if isOwner(userId) && isValidId(providerId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(providerId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'providerType', 'name', 'affiliation', 'phone', 'emergencyContact', 'address', 'portalLink', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'providerType', 'name', 'affiliation', 'phone', 'emergencyContact', 'address', 'portalLink', 'createdAt', 'updatedAt']) &&
                       isValidCareProvider(incoming());
      allow update: if isSignedIn() && isValidCareProvider(incoming()) &&
                       isOwner(userId) && isValidId(providerId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['providerType', 'name', 'affiliation', 'phone', 'emergencyContact', 'address', 'portalLink', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(providerId);
    }

    match /users/{userId}/voice_memos/{memoId} {
      allow get: if isOwner(userId) && isValidId(memoId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(memoId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'title', 'durationSec', 'timestampText', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'durationSec', 'timestampText', 'createdAt', 'updatedAt']) &&
                       isValidVoiceMemo(incoming());
      allow update: if isSignedIn() && isValidVoiceMemo(incoming()) &&
                       isOwner(userId) && isValidId(memoId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'durationSec', 'timestampText', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(memoId);
    }

