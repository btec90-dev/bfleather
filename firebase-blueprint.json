{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Synced maternal profile, pregnancy progression, daily health vitals, and user preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "patientName": { "type": "string" },
        "patientAge": { "type": "string" },
        "currentWeek": { "type": "integer" },
        "dueDate": { "type": "string" },
        "daysRemaining": { "type": "integer" },
        "dashboardDueDateText": { "type": "string" },
        "gestationalWeeks": { "type": "integer" },
        "gestationalDaysRemainder": { "type": "integer" },
        "remainingCountdownDays": { "type": "integer" },
        "currentTrimester": { "type": "string" },
        "progressPercent": { "type": "number" },
        "healthMood": { "type": "string" },
        "healthWeight": { "type": "string" },
        "waterGlasses": { "type": "integer" },
        "bloodPressure": { "type": "string" },
        "personalNotesText": { "type": "string" },
        "momAvatar": { "type": "string" },
        "partnerAvatar": { "type": "string" },
        "babyAvatar": { "type": "string" },
        "languageCode": { "type": "string", "enum": ["FR", "EN"] },
        "themePaletteName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": [
        "userId", "patientName", "patientAge", "currentWeek", "dueDate", "daysRemaining",
        "dashboardDueDateText", "gestationalWeeks", "gestationalDaysRemainder", "remainingCountdownDays",
        "currentTrimester", "progressPercent", "healthMood", "healthWeight", "waterGlasses",
        "bloodPressure", "personalNotesText", "momAvatar", "partnerAvatar", "babyAvatar",
        "languageCode", "themePaletteName", "createdAt", "updatedAt"
      ]
    },
    "TaskItem": {
      "title": "TaskItem",
      "description": "Patient clinical appointments, reminders, and checklist milestones",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "details": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "hasAlarm": { "type": "boolean" },
        "alarmTimeMinutesBefore": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "title", "date", "category", "details", "isCompleted", "hasAlarm", "alarmTimeMinutesBefore", "createdAt", "updatedAt"]
    },
    "PregnancyNote": {
      "title": "PregnancyNote",
      "description": "Daily symptom/emotional state logs and clinical notepad entries",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "timestampText": { "type": "string" },
        "mood": { "type": "string" },
        "symptoms": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "title", "content", "category", "timestampText", "mood", "symptoms", "createdAt", "updatedAt"]
    },
    "PrenatalAppointment": {
      "title": "PrenatalAppointment",
      "description": "Prenatal visits and monthly calendar scheduled events/medications",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "dateStr": { "type": "string" },
        "timeStr": { "type": "string" },
        "doctor": { "type": "string" },
        "location": { "type": "string" },
        "clinicalNotes": { "type": "string" },
        "eventType": { "type": "string" },
        "dayOfMonth": { "type": "integer" },
        "monthIndex": { "type": "integer" },
        "yearNum": { "type": "integer" },
        "isCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": [
        "userId", "title", "dateStr", "timeStr", "doctor", "location",
        "clinicalNotes", "eventType", "dayOfMonth", "monthIndex", "yearNum",
        "isCompleted", "createdAt", "updatedAt"
      ]
    },
    "MedicalDocument": {
      "title": "MedicalDocument",
      "description": "Medical vault documents, prescriptions, lab summaries, and ultrasound reports",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "dateStr": { "type": "string" },
        "summary": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "title", "category", "dateStr", "summary", "source", "createdAt", "updatedAt"]
    },
    "ChecklistItem": {
      "title": "ChecklistItem",
      "description": "Hospital bag and pre/post-birth preparation checklist items",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "listKey": { "type": "string" },
        "label": { "type": "string" },
        "isChecked": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "listKey", "label", "isChecked", "sortOrder", "createdAt", "updatedAt"]
    },
    "ProtocolStep": {
      "title": "ProtocolStep",
      "description": "PMA/IVF treatment timeline steps, medications, and monitoring",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "phaseId": { "type": "integer" },
        "dateStr": { "type": "string" },
        "stepName": { "type": "string" },
        "medication": { "type": "string" },
        "dosage": { "type": "string" },
        "status": { "type": "string" },
        "details": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "isCriticalWindow": { "type": "boolean" },
        "targetEpochMillis": { "type": "integer" },
        "sortOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": [
        "userId", "phaseId", "dateStr", "stepName", "medication", "dosage",
        "status", "details", "isCompleted", "isCriticalWindow", "targetEpochMillis",
        "sortOrder", "createdAt", "updatedAt"
      ]
    },
    "CareProvider": {
      "title": "CareProvider",
      "description": "Maternal care team provider contacts",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "providerType": { "type": "string" },
        "name": { "type": "string" },
        "affiliation": { "type": "string" },
        "phone": { "type": "string" },
        "emergencyContact": { "type": "string" },
        "address": { "type": "string" },
        "portalLink": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "providerType", "name", "affiliation", "phone", "emergencyContact", "address", "portalLink", "createdAt", "updatedAt"]
    },
    "VoiceMemo": {
      "title": "VoiceMemo",
      "description": "Recorded 30-second consultation voice memo metadata",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "durationSec": { "type": "integer" },
        "timestampText": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "title", "durationSec", "timestampText", "createdAt", "updatedAt"]
    },
    "KickLog": {
      "title": "KickLog",
      "description": "Fetal kick counter sessions",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "count": { "type": "integer" },
        "durationSeconds": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "count", "durationSeconds", "createdAt", "updatedAt"]
    },
    "WeightLog": {
      "title": "WeightLog",
      "description": "Maternal pregnancy weight tracker records",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "weightKg": { "type": "number" },
        "week": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "weightKg", "week", "createdAt", "updatedAt"]
    },
    "ContractionRecord": {
      "title": "ContractionRecord",
      "description": "Contraction timer recordings",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "durationSeconds": { "type": "integer" },
        "intervalSeconds": { "type": "integer" },
        "intensity": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "durationSeconds", "intervalSeconds", "intensity", "createdAt", "updatedAt"]
    },
    "WalletCard": {
      "title": "WalletCard",
      "description": "Personal digital wallet card with encrypted-at-rest metadata, gradient theme, and compressed front/back scanned images",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "cardTitle": { "type": "string" },
        "cardCategory": { "type": "string" },
        "cardNumber": { "type": "string" },
        "holderName": { "type": "string" },
        "expiryDate": { "type": "string" },
        "notes": { "type": "string" },
        "gradientKey": { "type": "string", "enum": ["teal", "sunset_orange", "magenta_blue", "deep_purple"] },
        "frontImageBase64": { "type": "string" },
        "backImageBase64": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": [
        "userId", "cardTitle", "cardCategory", "cardNumber", "holderName", "expiryDate",
        "notes", "gradientKey", "frontImageBase64", "backImageBase64", "sortOrder",
        "createdAt", "updatedAt"
      ]
    },
    "MedReminder": {
      "title": "MedReminder",
      "description": "Scheduled daily and protocol fertility/pregnancy medication reminders",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "medication": { "type": "string" },
        "dosage": { "type": "string" },
        "hour": { "type": "integer" },
        "minute": { "type": "integer" },
        "repeatDaily": { "type": "boolean" },
        "isEnabled": { "type": "boolean" },
        "protocolPhase": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": [
        "userId", "title", "medication", "dosage", "hour", "minute",
        "repeatDaily", "isEnabled", "protocolPhase", "notes", "createdAt", "updatedAt"
      ]
    },
    "PregnancyMedication": {
      "title": "PregnancyMedication",
      "description": "Editable pregnancy health and medication safety database entries",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "activeIngredient": { "type": "string" },
        "category": { "type": "string" },
        "safetyLevel": { "type": "string", "enum": ["SAFE", "CAUTION", "AVOID"] },
        "trimester1": { "type": "string" },
        "trimester2": { "type": "string" },
        "trimester3": { "type": "string" },
        "clinicalNotes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": [
        "userId", "name", "activeIngredient", "category", "safetyLevel",
        "trimester1", "trimester2", "trimester3", "clinicalNotes", "createdAt", "updatedAt"
      ]
    },
    "NutritionFood": {
      "title": "NutritionFood",
      "description": "Editable pregnancy nutrition food database (eat vs limit vs avoid)",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "safetyStatus": { "type": "string", "enum": ["EAT", "LIMIT", "AVOID"] },
        "highlights": { "type": "string" },
        "nutrients": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": [
        "userId", "name", "category", "safetyStatus", "highlights", "nutrients",
        "createdAt", "updatedAt"
      ]
    },
    "GroceryItem": {
      "title": "GroceryItem",
      "description": "Categorized pregnancy wellness grocery checklist item",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "label": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "string" },
        "isChecked": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": ["userId", "label", "category", "quantity", "isChecked", "createdAt", "updatedAt"]
    },
    "HealthIssue": {
      "title": "HealthIssue",
      "description": "Editable prenatal symptom, condition, doctor note, and treatment record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "trimester": { "type": "string" },
        "severity": { "type": "string" },
        "dateStr": { "type": "string" },
        "symptoms": { "type": "string" },
        "doctorNotes": { "type": "string" },
        "prescribedTreatment": { "type": "string" },
        "isResolved": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": [
        "userId", "title", "trimester", "severity", "dateStr", "symptoms",
        "doctorNotes", "prescribedTreatment", "isResolved", "createdAt", "updatedAt"
      ]
    },
    "ExpenseRecord": {
      "title": "ExpenseRecord",
      "description": "Multi-currency (USD/EUR/XOF) pregnancy medical and baby shopping expense record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string", "enum": ["USD", "EUR", "XOF"] },
        "category": { "type": "string" },
        "phase": { "type": "string" },
        "dateStr": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update" }
      },
      "required": [
        "userId", "title", "amount", "currency", "category", "phase",
        "dateStr", "notes", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/profile/{profileId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Synced maternal profile, health vitals, and preferences"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/TaskItem" },
      "description": "Personal clinical protocol checklist and user created tasks"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/PregnancyNote" },
      "description": "Daily symptom/mood logs and clinical notes"
    },
    "/users/{userId}/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/PrenatalAppointment" },
      "description": "Prenatal consultations and monthly calendar events"
    },
    "/users/{userId}/documents/{docId}": {
      "schema": { "$ref": "#/entities/MedicalDocument" },
      "description": "Medical vault documents and reports"
    },
    "/users/{userId}/checklists/{itemId}": {
      "schema": { "$ref": "#/entities/ChecklistItem" },
      "description": "Hospital bag and birth preparation checklist items"
    },
    "/users/{userId}/protocol_steps/{stepId}": {
      "schema": { "$ref": "#/entities/ProtocolStep" },
      "description": "PMA/IVF protocol timeline steps"
    },
    "/users/{userId}/care_providers/{providerId}": {
      "schema": { "$ref": "#/entities/CareProvider" },
      "description": "Saved medical providers and care team directory"
    },
    "/users/{userId}/voice_memos/{memoId}": {
      "schema": { "$ref": "#/entities/VoiceMemo" },
      "description": "Voice memo metadata entries"
    },
    "/users/{userId}/kick_logs/{kickId}": {
      "schema": { "$ref": "#/entities/KickLog" },
      "description": "Baby kick sessions"
    },
    "/users/{userId}/weight_logs/{logId}": {
      "schema": { "$ref": "#/entities/WeightLog" },
      "description": "Pregnancy weight entries"
    },
    "/users/{userId}/contractions/{contractionId}": {
      "schema": { "$ref": "#/entities/ContractionRecord" },
      "description": "Labor contraction logs"
    },
    "/users/{userId}/wallet_cards/{cardId}": {
      "schema": { "$ref": "#/entities/WalletCard" },
      "description": "Digital wallet cards with compressed front/back images and offline sync"
    },
    "/users/{userId}/med_reminders/{reminderId}": {
      "schema": { "$ref": "#/entities/MedReminder" },
      "description": "Scheduled medication notification alarms"
    },
    "/users/{userId}/preg_medications/{medId}": {
      "schema": { "$ref": "#/entities/PregnancyMedication" },
      "description": "Editable pregnancy medication safety database"
    },
    "/users/{userId}/nutrition_foods/{foodId}": {
      "schema": { "$ref": "#/entities/NutritionFood" },
      "description": "Editable pregnancy nutrition foods database"
    },
    "/users/{userId}/grocery_items/{itemId}": {
      "schema": { "$ref": "#/entities/GroceryItem" },
      "description": "Pregnancy grocery shopping list items"
    },
    "/users/{userId}/health_issues/{issueId}": {
      "schema": { "$ref": "#/entities/HealthIssue" },
      "description": "Prenatal health issues, doctor notes, and prescribed treatments"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/ExpenseRecord" },
      "description": "Pregnancy medical and baby shopping expenses ledger"
    }
  }
}
